:root {
  --link-color: blue;
}

.title
{
	margin: -2px -6px 14px -15px;
	padding: 0;
	flex-direction: column;
	align-items: stretch;
	background-color: var(--unity-colors-inspector_titlebar-background);
	border-bottom-width: 1px;
	border-bottom-color: var(--unity-colors-inspector_titlebar-border);
}

.title__icon
{
	width: 100%;
	aspect-ratio: 3.5;
}

.title__text
{
	margin: 0;
	padding: 16px 6px 16px 15px;
	font-size: 26px;
	flex-shrink: 1;
	white-space: normal;
	overflow: hidden;
}

.section
{
	align-items:flex-start;
	margin-bottom: 16px;
}

.section__header
{
	font-size: 20px;
	white-space: normal;
	-unity-font-style: bold;
}

.section__body
{
	font-size: 14px;
	white-space: normal;
}

.section__link
{
	font-size: 14px;
	white-space: nowrap;
	overflow: hidden;
	border-bottom-width: 1px;
	margin-bottom: -1px;
    border-bottom-color: transparent;
	color: var(--link-color);
}

.section__link:hover
{
    border-bottom-color: var(--link-color);
	cursor: link;
}

.remove-readme-button
{
	font-size: 13px;
	-unity-font-style: bold;
	margin: 1px 0px 1px 0px;
}
